# Next.js dùng NEXT_PUBLIC_*, không đọc các biến VITE_* của ScoreUp.
# Tương ứng VITE_API_URL trong ScoreUP/ScoreUp/.env.
NEXT_PUBLIC_SCOREUP_API_URL=http://localhost:3006/v1/api
NEXT_PUBLIC_SCOREUP_MEDIA_URL=http://localhost:3006/media/
# Path SSO cùng origin Portal, không gồm PORTAL_BASE_PATH. Để trống = mặc định /api/scoreplus/session
# (AI-Portal backend routes/scoreplus.ts). GET với cookie Portal; response { metadata: { token: "<ScoreUp bearer token>" } }.
NEXT_PUBLIC_PORTAL_SCOREUP_SESSION_PATH=
# Không đưa MongoDB hoặc APP_SECRET của backend vào frontend.
# Local Portal: để trống. Production ai.neu.edu.vn/apps: dùng /apps.
# npm run pack:neu đặt cấu hình production mà không thay đổi .env.local.
PORTAL_BASE_PATH=
