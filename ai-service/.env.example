# Sao chép thành .env (không commit). Khóa chỉ nằm ở server, không đưa vào frontend.
PORT=8090
# vllm: OpenAI-compatible (/v1/chat/completions) · ollama: /api/chat
LLM_PROVIDER=vllm
LLM_BASE_URL=http://101.96.66.232:8037/vllm
# Giá trị header x-ollama-seckey do Kong cấp (dùng chung cho /vllm và /ollama).
LLM_API_KEY=
LLM_MODEL=qwen3.5-35b-a3b-int4
LLM_TIMEOUT_MS=60000
# Ollama cũ: LLM_PROVIDER=ollama, LLM_BASE_URL=http://101.96.66.232:8037/ollama, LLM_MODEL=<model chat có trong /api/tags>
# Origin của frontend (không gồm path), cách nhau bởi dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ai.neu.edu.vn
RATE_LIMIT_PER_MINUTE=20
# Chính sách gợi ý (đề cương mục 5): ngưỡng số lần sai để lên cấp 2/3.
HINT_LEVEL2_ATTEMPTS=2
HINT_LEVEL3_ATTEMPTS=3
# true: câu thiếu lời giải đã xác minh → báo "chưa đủ căn cứ", không gọi LLM.
HINT_REQUIRE_SOLUTION=true
# true: cấp 3 được nêu đáp án đúng.
HINT_ALLOW_ANSWER_AT_LEVEL3=false
# Thư mục log JSONL (mặc định ai-service/logs, đã gitignore). Đặt rỗng để tắt log.
# HINT_LOG_DIR=
